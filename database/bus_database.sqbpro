lue="95"/><column index="5" value="76"/><column index="6" value="36"/><column index="7" value="49"/><column index="8" value="69"/><column index="9" value="87"/><column index="10" value="39"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="routes1_temp" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="81"/><column index="2" value="66"/><column index="3" value="95"/><column index="4" value="76"/><column index="5" value="36"/><column index="6" value="49"/><column index="7" value="69"/><column index="8" value="87"/><column index="9" value="37"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">DROP TABLE IF EXISTS routes1;
CREATE TABLE routes1 (
    route_id INTEGER PRIMARY KEY AUTOINCREMENT,
    from_district INTEGER,
    to_district INTEGER,
    departure_time TEXT,
    arrival_time TEXT,
    price INTEGER,
    bus_no TEXT,
    driver_info TEXT,
    drivers_cellno TEXT,
    seats INTEGER
);
INSERT INTO routes1 (
    from_district, to_district, departure_time, arrival_time,
    price, bus_no, driver_info, drivers_cellno, seats
)
SELECT * FROM routes1_temp;
</sql><sql name="Edit View route_display*">DROP VIEW IF EXISTS &quot;main&quot;.&quot;route_display&quot;;
CREATE VIEW route_display AS
SELECT 
    r.route_id,
    d1.district_name AS from_district,
    d2.district_name AS to_district,
    r.departure_time,
    r.arrival_time
FROM routes r
JOIN districts d1 ON r.from_district = d1.districts_id
JOIN districts d2 ON r.to_district = d2.districts_id
INSERT INTO routes1 (
    from_district, to_district, departure_time, arrival_time,
    price, bus_no, driver_info, drivers_cellno, seats
)
SELECT * FROM routes1_temp;
</sql><sql name="Edit View route_display*">DROP VIEW IF EXISTS &quot;main&quot;.&quot;route_display&quot;;

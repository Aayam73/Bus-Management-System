_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1"></sql><sql name="Edit View routes1_view*">DROP VIEW IF EXISTS &quot;main&quot;.&quot;routes1_view&quot;;
CREATE VIEW routes1_view AS
SELECT
    r.route_id,
    d1.district_name AS from_district,
    d2.district_name AS to_district,
    r.departure_time,
    r.arrival_time,
    r.price,
    r.bus_no,
    r.driver_info,
    r.drivers_cellno,
    r.seats,
	r.date
FROM routes1 r
JOIN districts d1 ON r.from_district = d1.districts_id
JOIN districts d2 ON r.to_district = d2.districts_id</sql><current_tab id="1"/></tab_sql></sqlb_project>
